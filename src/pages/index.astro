---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import hero from '../assets/images/el-legado-barberia-1.jpg';
---

<Layout>
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <Image
      src={hero}
      alt="El Legado Barbería"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      widths={[640, 1024, 1920]}
      sizes="100vw"
    />
    <div class="relative z-10 mx-auto max-w-2xl px-6 text-center">
      <p class="text-sm font-medium tracking-[0.3em] text-amber-500 uppercase">
        Próximamente
      </p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-6xl">
        El Legado Barbería
      </h1>
      <p class="mt-6 text-lg text-neutral-300">
        Estamos construyendo el sitio. El pipeline de despliegue ya está
        activo — cada cambio se publica automáticamente aquí.
      </p>
    </div>
  </main>
</Layout>
