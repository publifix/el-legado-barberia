---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logoMark from '../assets/images/logo-mark-white.png';
import { navLinks, site, whatsappLink, defaultWhatsappMessage } from '../lib/site';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <nav
    class="container-editorial flex h-20 items-center justify-between"
    aria-label="Navegación principal"
  >
    <a href="#inicio" class="flex items-center gap-3 shrink-0" aria-label={`${site.name} — Inicio`}>
      <Image src={logoMark} alt="" role="presentation" width={40} height={40} class="h-9 w-9 object-contain" />
      <span class="font-display text-lg font-bold tracking-wide text-paper">
        EL LEGADO<span class="hidden sm:inline text-gold"> BARBERÍA</span>
      </span>
    </a>

    <ul class="hidden items-center gap-9 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium tracking-wide text-paper/85 transition-colors duration-200 hover:text-gold"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden lg:block">
      <a
        href={whatsappLink(defaultWhatsappMessage)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-gold !min-h-11 !py-2.5 !text-sm"
      >
        <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
        Agendar por WhatsApp
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full text-paper lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <Icon name="lucide:menu" id="icon-menu-open" class="h-6 w-6" aria-hidden="true" />
      <Icon name="lucide:x" id="icon-menu-close" class="hidden h-6 w-6" aria-hidden="true" />
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-20 bottom-0 hidden bg-ink/98 backdrop-blur-xl lg:hidden"
  >
    <ul class="container-editorial flex flex-col gap-1 pt-8">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-mobile-link
              class="block border-b border-paper/10 py-4 font-display text-2xl font-semibold text-paper"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="container-editorial mt-8">
      <a
        href={whatsappLink(defaultWhatsappMessage)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-gold w-full"
      >
        <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
        Agendar por WhatsApp
      </a>
      <p class="eyebrow mt-6 text-paper/50">Sucursales en Querétaro</p>
      <a href={`tel:${site.phoneE164}`} class="mt-2 block font-display text-xl text-gold">
        {site.phoneDisplay}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  const setGlass = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add('nav-glass');
    } else {
      header.classList.remove('nav-glass');
    }
  };

  setGlass();
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          setGlass();
          ticking = false;
        });
        ticking = true;
      }
    },
    { passive: true }
  );

  const closeMenu = () => {
    mobileMenu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menú de navegación');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  };

  const openMenu = () => {
    mobileMenu?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Cerrar menú de navegación');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  mobileMenu?.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
