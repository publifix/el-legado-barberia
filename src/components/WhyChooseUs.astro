---
import { Icon } from 'astro-icon/components';
import { whyChooseUs } from '../lib/site';
---

<section class="bg-ink py-24 sm:py-32">
  <div class="container-editorial">
    <div class="reveal max-w-2xl">
      <p class="eyebrow text-gold">¿Por qué elegir El Legado?</p>
      <h2 class="mt-4 text-balance font-display text-3xl font-bold leading-tight text-paper sm:text-4xl md:text-5xl">
        Cuatro razones que se sienten desde la primera visita.
      </h2>
    </div>

    <ul class="reveal-stagger mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        whyChooseUs.map((block, index) => (
          <li class="relative border-t border-paper/15 pt-6">
            <span class="font-display text-sm font-semibold text-gold">
              {String(index + 1).padStart(2, '0')}
            </span>
            <Icon name={block.icon} class="mt-4 h-7 w-7 text-paper" aria-hidden="true" />
            <h3 class="mt-4 font-display text-lg font-semibold text-paper">{block.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-paper/65">{block.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
